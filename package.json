{
  "name": "@surea11y/pack-en301549",
  "version": "1.1.0",
  "description": "EN 301 549, the European accessibility standard, as a pack for @surea11y/core: chapter 9 (Web) in V3.2.1 and V4.1.1, one result per clause, a profile per version and clause mappings on any WCAG scan.",
  "keywords": [
    "accessibility",
    "a11y",
    "accessibility-testing",
    "a11y-testing",
    "en301549",
    "en-301-549",
    "european-accessibility-act",
    "eaa",
    "web-accessibility-directive",
    "wcag",
    "wcag21",
    "wcag22",
    "compliance",
    "surea11y",
    "surea11y-pack"
  ],
  "license": "MPL-2.0",
  "author": "Jorge Rumoroso",
  "homepage": "https://github.com/SureA11y/pack-en301549#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/pack-en301549.git"
  },
  "bugs": {
    "url": "https://github.com/SureA11y/pack-en301549/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./public": "./public.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "clauses.js",
    "groups.js",
    "public.js",
    "requirements.js",
    "rule-map.js",
    "i18n/*.json",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write \"*.js\" standard-to-review.json \"scripts/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"*.js\" standard-to-review.json \"scripts/**/*.js\" \"tests/**/*.js\"",
    "lint": "eslint .",
    "docs": "surea11y-pack docs",
    "docs:check": "surea11y-pack docs --check",
    "translations:review": "node scripts/translations-review.js",
    "test": "npm run format:check && npm run lint && npm run docs:check && node scripts/run-tests.js"
  },
  "peerDependencies": {
    "@surea11y/core": ">=1.13.0"
  },
  "devDependencies": {
    "@surea11y/core": "^1.14.0",
    "core-1.12": "npm:@surea11y/core@1.12.1",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
